# NexoHub — Configurações Locais de Ambiente (Opcional)
# Copie este arquivo para .env caso deseje personalizar diretórios locais.

# Caminho para instalação customizada do LanguageTool Community
# NEXOHUB_LANGUAGETOOL_DIR=C:\Users\username\.nexohub\runtime\languagetool

# Caminho para modelos locais de tradução (CTranslate2 / Opus-MT)
# NEXOHUB_MODELS_DIR=C:\Users\username\.nexohub\models

# Nível de log do Rust Core (trace, debug, info, warn, error)
# RUST_LOG=info
