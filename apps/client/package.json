{
  "name": "@nexohub/client",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "install:e2e": "playwright install --with-deps chromium",
    "preview": "vite preview",
    "screenshots": "pnpm build && node ./e2e/capturar-readme.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && node ./e2e/executar.mjs",
    "test:e2e:ci": "node ./e2e/executar.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@nexohub/contracts": "workspace:*",
    "@nexohub/domain": "workspace:*",
    "@nexohub/tool-registry": "workspace:*",
    "@nexohub/tool-sdk": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.542.0",
    "motion": "12.23.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
