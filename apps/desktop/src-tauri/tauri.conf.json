{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexoHub",
  "version": "0.1.0-alpha.1",
  "identifier": "com.nexohub.community",
  "build": {
    "beforeDevCommand": "pnpm --dir ../client dev",
    "beforeBuildCommand": "pnpm --dir ../client build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexoHub",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/runtime": "runtime",
      "../../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "windows": {
      "wix": {
        "version": "0.1.0.1001"
      }
    }
  }
}
