{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexoHub",
  "version": "0.2.1",
  "identifier": "com.nexohub.community",
  "build": {
    "beforeDevCommand": "pnpm --dir ../client dev",
    "beforeBuildCommand": "pnpm --dir ../client build",
    "devUrl": "http://localhost:5180",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexoHub",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob: data:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/runtime": "runtime",
      "../../../docs/quality/LANGUAGETOOL-LICENCAS-20261027.md": "runtime/LANGUAGETOOL-LICENCAS-20261027.md",
      "../../../docs/quality/languagetool-20261027-jars.json": "runtime/languagetool-20261027-jars.json",
      "../../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    }
  }
}
