{
  "name": "nexohub",
  "version": "0.0.0",
  "private": true,
  "description": "Estação documental open source e local-first.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/construir.mjs",
    "build:web": "pnpm --filter @nexohub/client build",
    "build:windows": "node scripts/construir.mjs --windows",
    "check": "biome check . && pnpm typecheck",
    "check:windows-dependencies": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verificar-dependencias-windows.ps1",
    "check:write": "biome check --write .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @nexohub/client test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
