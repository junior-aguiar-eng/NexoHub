{
  "name": "nexohub",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first open-source document workstation.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "biome check . && pnpm typecheck",
    "check:write": "biome check --write .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @nexohub/client test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
