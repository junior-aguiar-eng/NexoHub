{
  "name": "nexohub",
  "version": "0.2.4",
  "private": true,
  "description": "Estação documental open source e local-first.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @nexohub/desktop dev",
    "dev:desktop": "pnpm --filter @nexohub/desktop dev",
    "dev:web": "pnpm --filter @nexohub/client dev",
    "build": "node scripts/construir.mjs",
    "build:web": "pnpm --filter @nexohub/client build",
    "build:windows": "node scripts/construir.mjs --windows",
    "check": "biome check . && pnpm typecheck",
    "lint": "biome check .",
    "check:windows-dependencies": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verificar-dependencias-windows.ps1",
    "check:write": "biome check --write .",
    "licenses:generate": "node scripts/audit-licenses.mjs",
    "licenses:check": "node scripts/audit-licenses.mjs --check",
    "quality:check": "pnpm --filter @nexohub/tool-registry exec vitest run src/quality.test.ts quality-index.test.mjs --maxWorkers=2",
    "release:verify": "node scripts/verificar-release.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @nexohub/client test:e2e",
    "test:e2e:ci": "pnpm --filter @nexohub/client test:e2e:ci"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "undici": "^8.12.2",
    "sharp": "-",
    "@img/sharp-win32-x64": "-",
    "nanoid": ">=3.3.18",
    "vite": "^8.2.4",
    "fabric@7.4.0>canvas": "-",
    "fabric@7.4.0>jsdom": "-"
  }
}
