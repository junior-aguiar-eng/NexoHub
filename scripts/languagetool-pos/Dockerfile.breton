FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
RUN apt-get update && apt-get install -y --no-install-recommends build-essential autoconf automake libtool pkg-config libxml2-dev perl
COPY lttoolbox-2015.tar.gz /tmp/lttoolbox.tar.gz
RUN mkdir /opt/lttoolbox-source && tar -xzf /tmp/lttoolbox.tar.gz -C /opt/lttoolbox-source --strip-components=1
WORKDIR /opt/lttoolbox-source
RUN autoreconf -fi && ./configure --prefix=/opt/lttoolbox-2015 && make -C lttoolbox -j2 lt-expand CXXFLAGS=-std=gnu++11 && dpkg-query -W > /toolchain.tsv
ENV PATH=/opt/lttoolbox-source/lttoolbox:$PATH
WORKDIR /work
